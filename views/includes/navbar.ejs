<style>
  .btn-search {
    background-color: #047200;
    color: #fff;
    border-radius: 25px;
    padding: 0 1rem;
    height: 1.8rem;
  }

  .btn-search:hover {
    background-color: #047200;
    color: #fff;
  }

  .inp-search {
    border-radius: 25px;
    padding: 0.5rem 3rem;
    font-size: 1rem;
    height: 2rem;
  }
</style>

<nav class="navbar navbar-expand-lg bg-body-light border-bottom sticky-top">
  <div class="container-fluid">

    <!-- Logo -->
    <a class="navbar-brand" href="/listings">
      <i class="fa-solid fa-compass"></i>
    </a>

    <!-- Mobile toggle -->
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">

      <!-- Left -->
      <div class="navbar-nav">
        <a class="nav-link" href="/listings">Explore</a>
      </div>

      <!-- Search -->
      <div class="navbar-nav ms-auto">
        <form class="d-flex" role="search" action="/listings/search">
          <input 
            class="form-control me-2 inp-search" 
            type="search" 
            name="searchedLocation"
            placeholder="Search Location"
          >
          <button class="btn btn-search" type="submit">
            <i class="fa-solid fa-magnifying-glass"></i>
          </button>
        </form>
      </div>

      <!-- Right -->
      <div class="navbar-nav ms-auto align-items-center gap-2">

        <% if (currUser) { %>

          <!-- My Bookings -->
          <a class="nav-link" href="/my-bookings">
            <i class="fa-solid fa-calendar-check"></i>
          </a>

          <!-- Host -->
          <% if (isHost) { %>
            <a class="nav-link" href="/listings/new">
              <i class="fa-solid fa-house"></i>
            </a>
          <% } else { %>
            <a class="nav-link" href="/listings/new">
              <i class="fa-solid fa-user-plus"></i>
            </a>
          <% } %>

          <!-- User -->
          <span class="nav-link">
            <i class="fa-solid fa-user-circle"></i>
            <%= currUser.username %>
          </span>

          <!-- Logout -->
          <a class="nav-link text-danger" href="/logout">
            <i class="fa-solid fa-right-from-bracket"></i>
          </a>

        <% } else { %>

          <a class="nav-link" href="/signup">Sign up</a>
          <a class="nav-link" href="/login">Log in</a>

        <% } %>

      </div>
    </div>
  </div>
</nav>